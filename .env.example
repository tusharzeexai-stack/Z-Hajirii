# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# AWS API Gateway — get this URL from the CloudFormation stack output after deploying.
# Command: aws cloudformation describe-stacks --stack-name zhajirii-stack --query 'Stacks[0].Outputs'
VITE_API_GATEWAY_URL="https://<api-id>.execute-api.<region>.amazonaws.com/prod"

# JWT_SECRET: Set this as a Lambda environment variable in AWS Console or via CloudFormation parameter.
# This is a SERVER-SIDE secret — it must NEVER be placed in VITE_ prefixed variables or .env files
# that are bundled into the frontend build.
# Generate a strong random value: openssl rand -hex 32
# JWT_SECRET="your-secret-here"  <-- Set this in AWS Lambda env vars, NOT here
