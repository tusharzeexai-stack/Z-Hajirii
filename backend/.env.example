# ─────────────────────────────────────────────────────────────────────────────
# Z-Hajirii Backend — Environment Variables
# Copy this file to .env and fill in your real values.
# NEVER commit the actual .env file to Git.
# ─────────────────────────────────────────────────────────────────────────────

# ── Server ────────────────────────────────────────────────────────────────────
PORT=5000

# ── PostgreSQL (Amazon RDS) ───────────────────────────────────────────────────
# Find these in: AWS Console → RDS → Your DB Instance → Connectivity & Security
DB_HOST=your-rds-endpoint.ap-south-1.rds.amazonaws.com
DB_PORT=5432
DB_NAME=zhajirii
DB_USER=your_db_username
DB_PASS=your_db_password
DB_SSL=true

# ── JWT Authentication ────────────────────────────────────────────────────────
# Must match exactly the JWT_SECRET used in your Lambda functions.
# Generate a strong secret: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=your-super-secret-jwt-key-minimum-32-characters

# ── CORS Allowed Origins ──────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins.
ALLOWED_ORIGINS=https://z-hajirii.vercel.app,https://your-cloudfront-id.cloudfront.net,http://localhost:3000,http://localhost:5173
